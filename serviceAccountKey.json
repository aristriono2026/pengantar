import pandas as pd
import firebase_admin
from firebase_admin import credentials, firestore

# 1. Inisialisasi koneksi ke Firebase Firestore
cred = credentials.Certificate("serviceAccountKey.json")
firebase_admin.initialize_app(cred)
db = firestore.client()

# 2. Baca file CSV (Sesuaikan nama file jika berbeda)
df = pd.read_csv("data_warga.csv")

# 3. Looping data baris per baris dan sesuaikan dengan struktur aplikasi
for index, row in df.iterrows():
    # Menggabungkan Tempat Lahir dan Tanggal Lahir sesuai format aplikasi
    tempat_tgl_lahir = f"{str(row['Tempat Lahir'])}, {str(row['Tanggal Lahir'])}"
    
    warga_data = {
        "nik": str(row["NIK"]),
        "nama": str(row["Nama Lengkap"]),
        "jk": str(row["Jenis Kelamin"]), # Bisa disesuaikan jadi "Lk" / "Pr" jika di Excel tertulis "Laki-laki" / "Perempuan"
        "ttl": tempat_tgl_lahir,
        "agama": str(row["Agama"]),
        "status_kawin": str(row["Status"]),
        "pekerjaan": str(row["Pekerjaan"]),
        "hubunganKK": str(row["Hubungan dengan KK"]),
        "tempatTinggal": str(row["Tempat tinggal"]),
        "kewarganegaraan": "WNI", # Default WNI
        "kabupaten": "Cilacap Propinsi Jawa Tengah"
    }
    
    # Gunakan NIK sebagai ID dokumen agar pencarian menjadi sangat cepat
    db.collection("warga").document(str(row["NIK"])).set(warga_data)
    print(f"Berhasil diimpor -> NIK: {row['NIK']} | Nama: {row['Nama Lengkap']}")

print("\n🚀 Semua data warga berhasil diimpor ke database Firebase Cloud!")